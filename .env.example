# AURIX Agent - Environment Variables
# Copy to .env and fill in your keys

# LLM Provider (anthropic | openai | custom)
AURIX_PROVIDER=openai

# API Key
AURIX_API_KEY=sk-...

# Base URL (for OpenAI-compatible or Anthropic-compatible providers)
# AURIX_BASE_URL=https://api.openai.com/v1

# API Style (auto | openai | anthropic)
# Auto-detects endpoint format. Force if auto-detect fails.
# openai    = uses /v1/chat/completions (or /v1/completions fallback)
# anthropic = uses /v1/messages
# auto      = tries openai first, then anthropic
# AURIX_API_STYLE=auto

# Model name
AURIX_MODEL=gpt-4o

# Vision model (defaults to AURIX_MODEL)
# AURIX_VISION_MODEL=gpt-4o

# Search API (optional, falls back to DuckDuckGo)
# TAVILY_API_KEY=tvly-...
# SEARCH_API_KEY=...

# Spotify (optional, for music control)
# SPOTIFY_ACCESS_TOKEN=...
# SPOTIFY_TOKEN=...

# LangSmith tracing (optional, enables multi-agent observability)
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=aurix-agent

# Gateway tokens (optional)
# DISCORD_TOKEN=...
# TELEGRAM_TOKEN=...

# WhatsApp session stored in SQLite (~/.aurix/wa-session.db)
# No token needed - pairs via QR code on first run
